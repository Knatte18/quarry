# /quarry names both a binary built at the repo root and the quarry/ package
# directory. Ignore only the binary: the trailing-slash re-include keeps the
# package directory and its contents tracked.
/quarry
!/quarry/
*.test
*.test.exe
*.out
*.prof
.scratch/

# === mill-managed (regenerated by mill-setup) ===
**/.millhouse/
**/.scratch/
**/.wiki
**/.active
**/_mill/*.active
**/.portals
**/.vscode/
# === end mill-managed ===
