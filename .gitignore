# /quarry names both the built CLI binary at repo root (go build -o quarry
# ./cmd/quarry, per README) and the quarry/ package directory. Ignore only
# the binary: the trailing-slash re-include keeps the package directory and
# its contents tracked.
/quarry
!/quarry/
# The optional `go build -o quarry-mcp ./cmd/quarry-mcp` warm-start alternative documented in
# docs/mcp-setup.md. No collision with a package directory, so no re-include is needed.
/quarry-mcp
*.test
*.test.exe
*.out
*.prof
.scratch/

# Per-run ladder artifacts are disposable once summarised into the run's
# conclusion.md/summary.json, which stay tracked alongside them.
bench/loomyard-eval/ladder/results/**/raw/

# The cross-session lockfile is live session state, taken and released around one supervised launch --
# never part of a committed result.
bench/loomyard-eval/ladder/results/**/.session-active

# === mill-managed (regenerated by mill-setup) ===
**/.millhouse/
**/.scratch/
**/.wiki
**/.active
**/_mill/*.active
**/.portals
**/.vscode/
# === end mill-managed ===

# tools/runmatrix builds ladderbench here on every run
/ladderbench
