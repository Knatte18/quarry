# servers.yaml — the language-server registry. This file is OPERATOR-EDITABLE:
# it is never generated or overwritten by quarry itself (there is no "seed once"
# materialization step for servers.yaml), and every block here whole-replaces
# the matching built-in language entry -- there is no field-level merge, so
# overriding "command" for a language also requires repeating its
# markers/match/install_hint if you want to keep them.
#
# quarry looks for this file at the first of: --config <path>, $QUARRY_CONFIG,
# or os.UserConfigDir()/quarry/servers.yaml. Copy this example to whichever of
# those locations suits you and edit it there -- an absent file is not an
# error, quarry simply falls back to the built-in registry shown below.
#
# Add a new language, or override a built-in one, with a block like this:
# zig: {markers: [build.zig], match: any, command: [zls], install_hint: "install zls from https://github.com/zigtools/zls"}
#
# The five built-in languages below are shown at their default values; delete
# a block to fall back to its built-in, or edit any field to override it.
#
# initialization_options is a build-tag TEMPLATE, not a general static-configuration
# channel: its string values must contain the "{{tags}}" placeholder, which quarry
# replaces with the comma-joined, normalized --build-tags/$QUARRY_BUILD_TAGS set at
# query time. Only Go carries one today. Because a block whole-replaces its built-in
# counterpart (see above), a go: block that overrides this entry and drops
# initialization_options loses the template -- a subsequent --build-tags query then
# fails with an error naming the missing placeholder, rather than silently ignoring
# the flag.

go:
  markers: [go.mod]
  match: any
  command: [gopls]
  install_hint: "go install golang.org/x/tools/gopls@latest"
  pinned_version: v0.23.0
  has_native_daemon: true
  initialization_options: {buildFlags: ["-tags={{tags}}"]}
python:
  markers: [pyproject.toml, setup.py, setup.cfg]
  match: any
  command: [pyright-langserver, --stdio]
  install_hint: "npm install -g pyright"
csharp:
  markers: [.sln, .csproj]
  match: any
  command: [csharp-ls]
  install_hint: "dotnet tool install --global csharp-ls"
typescript:
  markers: [package.json, tsconfig.json]
  match: all
  command: [typescript-language-server, --stdio]
  install_hint: "npm install -g typescript-language-server typescript"
rust:
  markers: [Cargo.toml]
  match: any
  command: [rust-analyzer]
  install_hint: "install via rustup component add rust-analyzer"
